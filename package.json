{
  "name": "gita_daily_db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "data:download": "node scripts/download-data.mjs",
    "db:create": "wrangler d1 create gita-daily-db",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply gita-daily-db --remote",
    "webhook:set": "node scripts/set-webhook.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.166.0"
  }
}
